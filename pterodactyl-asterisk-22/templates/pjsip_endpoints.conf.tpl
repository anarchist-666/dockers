[endpoint-defaults](!)
type=endpoint
context=from-internal
disallow=all
allow=g722,ulaw,alaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733

[auth-defaults](!)
type=auth
auth_type=userpass

[aor-defaults](!)
type=aor
max_contacts=2
remove_existing=yes
qualify_frequency=30

{{DEMO_ENDPOINTS}}

;[mytrunk]
;type=registration
;outbound_auth=mytrunk
;server_uri=sip:sip.provider.example
;client_uri=sip:LOGIN@sip.provider.example
;retry_interval=60
;expiration=3600
;
;[mytrunk]
;type=auth
;auth_type=userpass
;username=LOGIN
;password=PASSWORD
;
;[mytrunk]
;type=aor
;contact=sip:sip.provider.example
;
;[mytrunk]
;type=endpoint
;context=from-trunk
;disallow=all
;allow=ulaw,alaw
;outbound_auth=mytrunk
;aors=mytrunk
;direct_media=no
;rtp_symmetric=yes
;force_rport=yes
;
;[mytrunk]
;type=identify
;endpoint=mytrunk
;match=PROVIDER_IP
